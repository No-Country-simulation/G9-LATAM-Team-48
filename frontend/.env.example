# Backend Spring (vacío en Docker/nginx = misma origen)
VITE_API_URL=http://localhost:8080

# Login real contra Spring (solo local sin backend: VITE_USE_MOCK_AUTH=true)
VITE_USE_MOCK_AUTH=false

# Microservicio ML (FastAPI) — referencia; Análisis IA va vía backend
VITE_ML_API_URL=http://localhost:8000

# Google Sign-In (mismo valor que GOOGLE_CLIENT_ID en el backend)
# Google Cloud Console → OAuth 2.0 Client ID (Web)
# Origins: http://localhost:5173 y https://tu-app.vercel.app
VITE_GOOGLE_CLIENT_ID=

# Solo si VITE_USE_MOCK_AUTH=true (local, nunca en prod)
# VITE_DEMO_OPERADOR_PASSWORD=
# VITE_DEMO_ADMIN_PASSWORD=
# VITE_DEMO_TEAM_PASSWORD=
