# Backend Spring (vacío en Docker/nginx = misma origen)
VITE_API_URL=http://localhost:8080

# Con Postgres + backend real: false
# Solo demo sin backend: true
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_API=false

# Microservicio ML (FastAPI)
VITE_ML_API_URL=http://localhost:8000

# Google Sign-In (mismo valor que GOOGLE_CLIENT_ID en el backend)
# Google Cloud Console → OAuth 2.0 Client ID (Web)
# Origins: http://localhost:5173 y https://tu-app.vercel.app
VITE_GOOGLE_CLIENT_ID=
