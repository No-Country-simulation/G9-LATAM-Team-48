# ============================================================================
# Variables de entorno - backend (desarrollo local)
# ============================================================================
# Creá la DB en MySQL (Laragon / XAMPP / Docker):
#   CREATE DATABASE energia_ia CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# Por defecto sin estas vars: usuarios en memoria + H2.
# Para MySQL + Flyway:

APP_PERSISTENCE_TYPE=jpa
FLYWAY_ENABLED=true
JPA_DDL=validate
DB_URL=jdbc:mysql://localhost:3306/energia_ia?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=root
DB_PASSWORD=
DB_DRIVER=com.mysql.cj.jdbc.Driver

# SMTP Gmail (local y prod OCI). App Password: Google → Seguridad → Contraseñas de aplicaciones.
# No commitear credenciales reales. Sin RESEND_API_KEY el backend usa solo SMTP.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=tu_app_password_16_caracteres
MAIL_FROM=tu_cuenta@gmail.com
FRONTEND_BASE_URL=http://localhost:5173

# Google Sign-In (mismo Client ID en frontend VITE_GOOGLE_CLIENT_ID)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins: http://localhost:5173 y tu URL de Vercel
GOOGLE_CLIENT_ID=

# Microservicio ML (ml-service). Local: docker compose / uvicorn :8000
PREDICTION_API_BASE_URL=http://localhost:8000
# Render free tier: cold start; prod suele usar 60000 ms
PREDICTION_API_TIMEOUT=60000

# Umbrales heurísticos (SHAP / métricas) — opcional; defaults en application.yml
# APP_CALCULATION_DEFAULT_OCCUPANTS_COUNT=2
# APP_CALCULATION_DEFAULT_CONSUMPTION_PER_PERSON=150.0
# APP_CALCULATION_INSULATION_FACTOR_POOR=1.3
# APP_CALCULATION_INSULATION_FACTOR_FAIR=1.0
# APP_CALCULATION_INSULATION_FACTOR_GOOD=0.7
# APP_CALCULATION_LED_PROPORTION_HIGH=0.75
# (aislamiento SHAP v3: Malo=1.3 / Regular=1.0 / Bueno=0.7)

