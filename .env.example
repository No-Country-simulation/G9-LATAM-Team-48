# Copiar a .env en la raíz del proyecto (NO subir .env a Git)

# Puertos publicados en el NAS
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Backend
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRATION=86400000

# Microservicio de predicción (cuando exista). Mientras tanto puede quedar así.
PREDICTION_API_BASE_URL=http://host.docker.internal:8000
