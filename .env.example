# Copiar a .env en la raíz del proyecto (NO subir .env a Git)

# Puertos publicados
FRONTEND_PORT=3000
BACKEND_PORT=8080
ML_PORT=8000
MYSQL_PORT=3306

# Backend
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRATION=86400000

# Microservicio de predicción (en docker-compose: http://ml:8000)
PREDICTION_API_BASE_URL=http://ml:8000

# MySQL
MYSQL_DATABASE=energia_ia
MYSQL_USER=energia_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
