# Copiar a .env en la raíz del proyecto (NO subir .env a Git)
# Stack pensado para Docker en el NAS: http://192.168.0.166
# Uso en el NAS: docker compose up -d --build

# Puertos publicados (en la LAN del NAS)
FRONTEND_PORT=3000
BACKEND_PORT=8080
ML_PORT=8000
MYSQL_PORT=3306

# URL pública del front en la LAN (links de verify / reset password)
FRONTEND_BASE_URL=http://192.168.0.166:3000

# Backend
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRATION=86400000

# Microservicio de predicción (nombre del servicio en docker-compose)
PREDICTION_API_BASE_URL=http://ml:8000

# MySQL
MYSQL_DATABASE=energia_ia
MYSQL_USER=energia_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# SMTP (opcional en NAS; si no hay mail, dejá MAIL_ENABLED=false)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# No usar RESEND en prod OCI del equipo; Gmail SMTP vía MAIL_* (ver docs/DEPLOY_PRODUCCION.md)

# Google Sign-In — mismo Client ID en backend y frontend
# Google Cloud Console → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins:
#   http://192.168.0.166:3000
#   http://localhost:5173
#   https://g9-latam-team-48.vercel.app
GOOGLE_CLIENT_ID=
# Debe coincidir con GOOGLE_CLIENT_ID (si lo dejás vacío, el botón Google no aparece en el front)
VITE_GOOGLE_CLIENT_ID=
