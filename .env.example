# Copiar a .env en la raíz del proyecto (NO subir .env a Git)

# Puertos publicados
FRONTEND_PORT=3000
BACKEND_PORT=8080
ML_PORT=8000
POSTGRES_PORT=5432

# Backend
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRATION=86400000

# Microservicio de predicción (en docker-compose: http://ml:8000)
PREDICTION_API_BASE_URL=http://ml:8000

# PostgreSQL
POSTGRES_DB=energia_ia
POSTGRES_USER=energia_app
POSTGRES_PASSWORD=change-me
