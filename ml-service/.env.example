# Copiá los 3 .joblib v3 del equipo a ml-service/models/ (ver scripts/copy-v3-models.ps1)
#
# --- Local (uvicorn) ---
# Prioridad: trio v3 en models/ → si no, model.joblib → si no, descargas por URL
#
# MODEL_V3_BASE_URL=https://tu-bucket o release/raw/main/ml-service/models
# o URLs individuales:
# MODEL_V3_COLUMNS_URL=
# MODEL_V3_ENCODER_URL=
# MODEL_V3_MODEL_URL=
#
# Legacy (solo si NO hay trio v3):
# MODEL_PATH=models/model.joblib
# MODEL_URL=https://...
