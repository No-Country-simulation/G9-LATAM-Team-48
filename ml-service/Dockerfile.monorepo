FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Cache-bust: cambiar este valor fuerza rebuild completo en Render (pip + COPY models).
ARG CACHE_BUST=2026-08-17-v3-01

COPY ml-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ml-service/app ./app
COPY ml-service/src ./src
COPY ml-service/models ./models
# Canon DS: datascience/models (trio v3 exportado en notebooks)
COPY datascience/models ./models-ds
ENV PYTHONPATH=/app
RUN set -e; \
    if [ -d models-ds ]; then \
      for f in models-ds/columnas_requeridas_final_v3.joblib \
               models-ds/label_encoder_v3.joblib \
               models-ds/modelo_perfil_energetico_final_v3.joblib \
               models-ds/model_pipeline_v3.joblib; do \
        if [ -f "$f" ]; then cp "$f" models/; fi; \
      done; \
      if [ ! -f models/modelo_perfil_energetico_final_v3.joblib ] \
         && [ -f models/model_pipeline_v3.joblib ]; then \
        cp models/model_pipeline_v3.joblib models/modelo_perfil_energetico_final_v3.joblib; \
      fi; \
    fi; \
    echo "=== Contenido /app/models (build) ===" && ls -la models && \
    echo "=== Versiones libs ===" && pip show scikit-learn lightgbm 2>/dev/null | grep -E "Name|Version"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=5 \
  CMD python -c "import os,urllib.request; p=os.environ.get('PORT','8000'); urllib.request.urlopen(f'http://127.0.0.1:{p}/health')"

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
